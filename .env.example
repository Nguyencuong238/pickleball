APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

DB_HOST_POS=127.0.0.1
DB_PORT_POS=3306
DB_DATABASE_POS=pickleball_pos
DB_USERNAME_POS=root
DB_PASSWORD_POS=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Digital Ocean Spaces
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=us-east-1
DO_SPACES_BUCKET=
DO_SPACES_ROOT=
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_URL=

# Media Disk (set to 'do' for Digital Ocean Spaces, 'public' for local)
MEDIA_DISK=public

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost/auth/google/callback

# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=http://localhost/auth/facebook/callback

# Gems Wallet
GEMS_EXCHANGE_RATE=1000
GEMS_CASHBACK_PERCENT=5
GEMS_MIN_TOPUP_VND=50000
GEMS_MAX_TOPUP_VND=5000000
GEMS_BANK_ACCOUNT_NUMBER=
GEMS_BANK_BIN=
GEMS_BANK_NAME=
GEMS_BANK_ACCOUNT_NAME=
# Mô hình chuyển Gems (payer → chủ sân/CLB) với escrow hoàn tiền
GEMS_TRANSFER_ENABLED=false
GEMS_REFUND_WINDOW_DAYS=1
GEMS_PLATFORM_FEE_PERCENT=0
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=
SEPAY_API_KEY=
SEPAY_ALLOWED_IPS=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GEMS_TRANSFER_ENABLED=true